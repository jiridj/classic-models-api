# GitHub Container Registry Configuration
GITHUB_REPOSITORY=your-username/classic-models-api
API_VERSION=latest

# Django Configuration
DEBUG=0
SECRET_KEY=your-very-secure-secret-key-here-change-this
ALLOWED_HOSTS=192.168.1.8,localhost,127.0.0.1
# API Base URL for OpenAPI schema (defaults to http://localhost:8000)
# API_BASE_URL=https://qnap-jiri.myqnapcloud.com

# JWT (self-managed) configuration
# By default, if JWT_PRIVATE_KEY_PEM/JWT_PUBLIC_KEY_PEM are NOT set, the app falls back to HS256 using SECRET_KEY.
# For API gateways (e.g. API Connect + DataPower Nano Gateway), prefer RS256 + JWKS.
#
# Issuer and audience are validated by the API when set and can also be validated at the gateway.
JWT_ISSUER=https://your-issuer.example.com
JWT_AUDIENCE=classic-models-api
# Optional clock-skew leeway in seconds
JWT_LEEWAY_SECONDS=0
#
# RS256 keys (PEM). Use multi-line values in your real .env (Docker Compose supports this via env_file or secrets).
# JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
#
# Optional key id for JWT header `kid` and JWKS `kid`.
# If not set, the server derives a deterministic kid from the RSA public key (RFC7638 thumbprint).
# JWT_KEY_ID=your-key-id

# API Key Authentication (optional - for system-level access)
# If set, allows authentication via X-API-Key header with full admin access
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secure-api-key-here-change-this

# MySQL Configuration
MYSQL_ROOT_PASSWORD=your-secure-root-password
MYSQL_DATABASE=classicmodels
MYSQL_USER=classicuser
MYSQL_PASSWORD=your-secure-mysql-password
